{
  "name": "tea-cup-package",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo for tea-cup libraries",
  "scripts": {
    "build": "pnpm --filter \"!*rte*\" build",
    "check": "pnpm --filter \"!*rte*\" check",
    "check-circular": "pnpm --filter \"!*rte*\" check-circular",
    "lint": "pnpm --filter \"!*rte*\" lint",
    "format": "pnpm --filter \"!*rte*\" format",
    "staged": "pnpm --filter \"!*rte*\" staged"
  },
  "devDependencies": {
    "madge": "^8.0.0"
  }
}
